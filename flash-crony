#!/usr/bin/env bash
#
# flash_crony.sh — Compile and flash the "crony" keymap to the Silakka54
#
# The Silakka54 uses RP2040 Zero controllers, so each half must be
# flashed separately with its own UF2 file:
#   - uf2-split-left   (left half)
#   - uf2-split-right  (right half)
#
# The -bl uf2-split-* flags write the handedness value to EEPROM.
# This is REQUIRED for keyboards using EE_HANDS (like the Silakka54).
# For keyboards using SPLIT_HAND_PIN or SPLIT_HAND_MATRIX_GRID, the
# flags are harmless (handedness is hardware-determined and the EEPROM
# value is simply ignored).
#
# Usage:
#   ./flash_crony.sh          # compile + flash both halves
#   ./flash_crony.sh compile  # compile only, no flashing
#   ./flash_crony.sh left     # flash left half only
#   ./flash_crony.sh right    # flash right half only
#

set -euo pipefail

KEYBOARD="silakka54"
KEYMAP="crony"

# ─── Colors ───
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

# ─── TRRS safety warning ───

trrs_warning() {
    echo
    echo -e "${RED}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║                                                                      ║${NC}"
    echo -e "${RED}║   ${BOLD}⚠  TRRS HOT-PLUG WARNING — READ THIS CAREFULLY  ⚠${NC}                    ${RED}║${NC}"
    echo -e "${RED}║                                                                      ║${NC}"
    echo -e "${RED}║   The Silakka54 has NO ESD/short protection on the TRRS jack.       ║${NC}"
    echo -e "${RED}║   Connecting or disconnecting the TRRS cable while either half      ║${NC}"
    echo -e "${RED}║   is powered can SHORT 5V to GROUND and DESTROY the controller.    ║${NC}"
    echo -e "${RED}║                                                                      ║${NC}"
    echo -e "${RED}║   ${BOLD}ALWAYS follow this power sequence:${NC}                              ${RED}║${NC}"
    echo -e "${RED}║                                                                      ║${NC}"
    echo -e "${RED}║     1. UNPLUG both halves from USB (power off)                       ║${NC}"
    echo -e "${RED}║     2. CONNECT the TRRS cable between the two halves                 ║${NC}"
    echo -e "${RED}║     3. PLUG IN the LEFT half to USB (this powers both)              ║${NC}"
    echo -e "${RED}║                                                                      ║${NC}"
    echo -e "${RED}║   To disconnect: unplug USB FIRST, then disconnect TRRS.            ║${NC}"
    echo -e "${RED}║                                                                      ║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo
}

# ─── Functions ───

compile_firmware() {
    info "Compiling ${KEYBOARD}/${KEYMAP} ..."
    qmk compile -kb "$KEYBOARD" -km "$KEYMAP"
    ok "Compilation finished."
}

flash_half() {
    local half="$1"
    local bootloader="uf2-split-${half}"

    echo
    echo -e "${YELLOW}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}  Flashing ${half^^} half of ${KEYBOARD}/${KEYMAP}${NC}"
    echo -e "${YELLOW}  (bootloader: ${bootloader})${NC}"
    echo -e "${YELLOW}═══════════════════════════════════════════════════════════════${NC}"
    echo
    info "Make sure the TRRS cable is DISCONNECTED."
    info "Flash each half on its own, connected only via USB."
    echo
    info "Put the ${half^^} half into bootloader mode:"
    echo -e "    ${CYAN}Option 1:${NC} Hold the BOOT button on the RP2040 Zero"
    echo -e "            and connect it to the PC via USB."
    echo -e "    ${CYAN}Option 2:${NC} If already running, press the key mapped to"
    echo -e "            ${CYAN}QK_BOOT${NC} to enter bootloader mode."
    echo
    read -rp "$(echo -e ${CYAN}[Press Enter when the ${half^^} half is in bootloader mode]${NC})"

    info "Flashing ${half} half ..."
    if qmk flash -kb "$KEYBOARD" -km "$KEYMAP" -bl "$bootloader"; then
        ok "${half^^} half flashed successfully."
    else
        error "Flashing the ${half} half failed. Check the output above."
        return 1
    fi
}

usage() {
    echo "Usage: $0 [compile|left|right]"
    echo
    echo "  (no argument)  Compile firmware, then flash left half, then right half"
    echo "  compile        Compile only, do not flash"
    echo "  left           Flash left half only (assumes firmware is compiled)"
    echo "  right          Flash right half only (assumes firmware is compiled)"
    echo
}

# ─── Main ───

main() {
    local target="${1:-all}"

    if ! command -v qmk &>/dev/null; then
        error "qmk CLI not found. Install it with: python3 -m pip install qmk"
        exit 1
    fi

    case "$target" in
        all)
            compile_firmware

            trrs_warning
            read -rp "$(echo -e ${CYAN}[Press Enter when you\'ve read and understood the warning]${NC})"

            flash_half "left"  || { error "Aborting — left half failed."; exit 1; }
            flash_half "right" || { error "Aborting — right half failed."; exit 1; }

            echo
            ok "Both halves of ${KEYBOARD}/${KEYMAP} are flashed."
            echo

            # ── Final reconnection instructions ──
            echo -e "${YELLOW}═══════════════════════════════════════════════════════════════${NC}"
            echo -e "${YELLOW}  RECONNECTING THE KEYBOARD — FOLLOW IN ORDER${NC}"
            echo -e "${YELLOW}═══════════════════════════════════════════════════════════════${NC}"
            echo
            echo -e "  ${RED}${BOLD}Do NOT plug in USB while the TRRS cable is connected${NC}"
            echo -e "  ${RED}${BOLD}unless both halves were powered off first!${NC}"
            echo
            echo -e "  ${GREEN}1.${NC} UNPLUG both halves from USB"
            echo -e "     (make sure neither half is connected to the PC)"
            echo
            echo -e "  ${GREEN}2.${NC} CONNECT the TRRS cable between the two halves"
            echo
            echo -e "  ${GREEN}3.${NC} PLUG IN the LEFT half to USB"
            echo -e "     (this powers both halves through the TRRS cable)"
            echo
            echo -e "  ${CYAN}To disconnect later:${NC} unplug USB FIRST, then TRRS."
            echo
            echo -e "${YELLOW}═══════════════════════════════════════════════════════════════${NC}"
            echo
            ok "Done! Your Silakka54 is ready to use with the crony keymap."
            ;;
        compile)
            compile_firmware
            ;;
        left)
            trrs_warning
            read -rp "$(echo -e ${CYAN}[Press Enter when you've read and understood the warning]${NC})"
            flash_half "left"
            ;;
        right)
            trrs_warning
            read -rp "$(echo -e ${CYAN}[Press Enter when you\'ve read and understood the warning]${NC})"
            flash_half "right"
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            error "Unknown argument: '$target'"
            usage
            exit 1
            ;;
    esac
}

main "$@"
